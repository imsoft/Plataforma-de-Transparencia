# ─── Base de datos ──────────────────────────────────────────────
# local: Postgres de Docker · producción: Neon (DATABASE_DRIVER=neon)
DATABASE_DRIVER=postgres
# Rol con permisos de migración (drizzle-kit, pnpm setup). Nunca en Vercel.
DATABASE_URL_MIGRATIONS=postgres://migrator:migrator@localhost:5432/transparency
# Rol del panel (lectura/escritura con RLS)
DATABASE_URL=postgres://app_panel:app_panel@localhost:5432/transparency
# Rol de los sitios públicos (solo lectura)
DATABASE_URL_PUBLIC=postgres://public_reader:public_reader@localhost:5432/transparency

# ─── Archivos (S3: RustFS local / Cloudflare R2 en producción) ───
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=transparencia
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
# Dominio público desde el que se sirven los archivos (R2 custom domain). Local: RustFS.
FILES_PUBLIC_URL=http://localhost:9000/transparencia

# ─── Correo (Mailpit local / Resend en producción) ──────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_FROM="Plataforma de Transparencia <no-responder@localhost>"

# ─── Auth ───────────────────────────────────────────────────────
BETTER_AUTH_SECRET=cambia-esto-por-32-caracteres-aleatorios
BETTER_AUTH_URL=http://localhost:3000

# Secretos de revalidación por municipio (JSON slug → secreto); cada app de sitio tiene el suyo en su .env.local
REVALIDATION_SECRETS={"tuxcacuesco":"secreto-local-tuxcacuesco-0123456789"}

# ─── Plataforma ─────────────────────────────────────────────────
NEXT_PUBLIC_PLATFORM_NAME="Plataforma de Transparencia"
PANEL_DOMAIN=localhost:3000

# ─── Sitios de municipio (en cada apps/site-*/.env.local) ──────
# MUNICIPALITY_SLUG=tuxcacuesco
# REVALIDATION_SECRET=...

# Vercel Cron (reintentos de revalidación). Vercel lo manda como Authorization: Bearer
CRON_SECRET=cambia-esto-por-un-secreto-largo
