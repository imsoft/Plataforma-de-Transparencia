{
  "name": "transparency-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d --wait postgres rustfs mailpit && docker compose run --rm bucket-init",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && pnpm docker:up",
    "db:generate": "pnpm --filter @platform/db generate",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "new-municipality": "tsx scripts/new-municipality.ts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "migrate:tuxcacuesco": "tsx scripts/migrate-tuxcacuesco/index.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@clack/prompts": "catalog:",
    "@platform/files": "workspace:*",
    "@platform/auth": "workspace:*",
    "@platform/config": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/law-index": "workspace:*",
    "@platform/transparency": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "node-html-parser": "catalog:",
    "only-allow": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
