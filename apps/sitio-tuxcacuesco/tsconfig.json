{
  "extends": "@plataforma/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./*"],
      "@plataforma/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "app/.well-known/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
